# Option 1: Full MySQL Connection URL (Recommended for cloud/Docker)
# Example: mysql://username:password@localhost:3306/galaxy_green
DATABASE_URL=mysql://root:password@localhost:3306/galaxy_green

# Option 2: Discrete MySQL Connection Parameters
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=galaxy_green
